# APP_DOMAIN doit être un nom DNS public que vous contrôlez et qui pointe vers le VPS.
# L'adresse *.myshopify.com ne peut PAS servir pour cette application indépendante.
{$APP_DOMAIN} {
  encode zstd gzip
  reverse_proxy web:3000
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  log {
    output stdout
    format json
  }
}
