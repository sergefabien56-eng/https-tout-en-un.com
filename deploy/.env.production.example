# COPIER EN .env.production HORS DU DÉPÔT (chmod 600). JAMAIS COMMITER.
APP_ENV=production
APP_DOMAIN=app.example.com
APP_URL=https://app.example.com
DATABASE_URL=postgres://toutenun_app:REPLACE_PASSWORD@postgres:5432/tout_en_un
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
SESSION_SECRET=REPLACE_WITH_RANDOM_BASE64_32_BYTES
APP_ENC_KEYS=1:REPLACE_WITH_RANDOM_BASE64_32_BYTES
APP_ENC_ACTIVE=1
DEFAULT_TIMEZONE=Africa/Abidjan
REFERENCE_CURRENCY=XOF
SMTP_HOST=REPLACE
SMTP_PORT=587
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=REPLACE
