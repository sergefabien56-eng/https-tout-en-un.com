# --- Application ---------------------------------------------------------
APP_ENV=development              # development | staging | production
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Africa/Abidjan
REFERENCE_CURRENCY=XOF

# --- Base de données -----------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5432/tout_en_un

# --- Secrets (valeurs factices ci-dessous, à remplacer) ------------------
# openssl rand -base64 32
SESSION_SECRET=CHANGEME_32_BYTES_BASE64
# Ring de clés : "version:base64,version:base64" + version active
APP_ENC_KEYS=1:CHANGEME_32_BYTES_BASE64
APP_ENC_ACTIVE=1

# --- SMTP (notifications critiques) ---------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- Sauvegardes ---------------------------------------------------------
BACKUP_TARGET=
BACKUP_PASSPHRASE=

# --- MIMI (Phase 5) ------------------------------------------------------
LLM_API_KEY=
